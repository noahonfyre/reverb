{
	"schemaVersion": 1,
	"id": "reverb",
	"version": "${version}",
	"name": "reverb",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/reverb/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.nyronium.Reverb",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.nyronium.client.ReverbClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"reverb.mixins.json",
		{
			"config": "reverb.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}